ML_HOST=127.0.0.1
ML_PORT=8000
# Required when ENVIRONMENT=production (the service refuses to start without it). Set the same value in the Node backend.
# Without a key, anyone who can reach the service can train a model or switch the active one.
ML_SERVICE_KEY=
# Where trained models and reports are stored. Hosted: a mounted volume (the Docker image uses /data/models and /data/reports).
MODEL_DIR=./models
REPORT_DIR=./reports
ML_RELOAD=false
